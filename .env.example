# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Variables are grouped into REQUIRED and OPTIONAL:
# - REQUIRED: the app needs these to boot and let you sign in.
# - OPTIONAL: each one unlocks a feature that stays disabled until its vars are
#   present. The app boots fine without them.

# ##############################################################################
# REQUIRED
# ##############################################################################

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by Next.js routes and Drizzle.
#
# Local development / admin operations:
# - Prefer the Supabase "Direct connection" string.
# - Best for `pnpm run db:migrate`, `pg_dump`, `psql`, and restore scripts.
#
# Production / Vercel:
# - Prefer the Supabase "Connection Pooler" string.
#
# If your password contains special characters, use the URL-encoded form.
DATABASE_URL=

# ------------------------------------------------------------------------------
# App secrets
# ------------------------------------------------------------------------------
# Signs the app's `get_word_session` login cookie and OpenRouter OAuth state
# cookies. This session is the app's real source of truth (Supabase is only a
# one-shot identity verifier during login).
# Also derives the hash key for school access codes, so rotating this value
# invalidates every issued /school/redeem link as well as every login session.
# Generate with:
#   openssl rand -base64 32
APP_SESSION_SECRET=

# Encrypts stored BYOK provider API keys at rest.
# Must be a stable 32-byte hex string.
# Generate with:
#   openssl rand -hex 32
APP_ENCRYPTION_SECRET=

# ------------------------------------------------------------------------------
# Supabase auth (primary login)
# ------------------------------------------------------------------------------
# Sign-in uses Supabase Auth: email one-time code and Google OAuth. Supabase is
# only a one-shot identity verifier — the `/api/auth/callback` route verifies the
# Supabase user, then the app mints its own long-lived `get_word_session` cookie
# (see APP_SESSION_SECRET), which is the trusted session afterwards.
# Find these in Supabase: Project Settings -> API keys.
#   - URL:              Project Settings -> API -> Project URL
#   - Publishable key:  the "Publishable key" (sb_publishable_…). Browser-safe.
# NEVER put the secret/service_role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# In the Supabase dashboard, also:
#   - Authentication -> Providers: enable Email and Google.
#   - Authentication -> URL Configuration -> Redirect URLs: add
#     http://localhost:3000/api/auth/callback (and your production equivalent).
#   - The email login is OTP-code based: turn "Confirm email" off and edit the
#     "Magic Link" email template to print {{ .Token }} instead of the default
#     link. See DEVELOPMENT.md ("Supabase Auth Setup") for the exact steps.

# ##############################################################################
# OPTIONAL
# ##############################################################################

# ------------------------------------------------------------------------------
# Supabase admin (account deletion)
# ------------------------------------------------------------------------------
# Server-only secret "service_role" key. Grants admin access to the Supabase
# Auth API, used to delete a user's auth.users row during account deletion
# (DELETE /api/auth/account). Without it, deletion still erases all app data but
# cannot remove the Supabase auth identity: the request reports "completing" and
# a pending account_deletion_jobs row is retried by
# `pnpm run account:process-deletions` once the key is configured.
# Find it in Supabase: Project Settings -> API keys -> service_role (secret).
# NEVER expose this in a NEXT_PUBLIC_ var or client code.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# App base URL
# ------------------------------------------------------------------------------
# Public base URL used for absolute callback URLs (e.g. OAuth callbacks).
# Local dev can keep the default below. Set your real domain in production.
GET_WORD_APP_URL=http://localhost:3000

# Browser-visible version used when starting Supabase/Google OAuth.
# Set this to the same real production origin as GET_WORD_APP_URL.
NEXT_PUBLIC_GET_WORD_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Local source database override (dump/restore scripts)
# ------------------------------------------------------------------------------
# Defaults to Supabase CLI local Postgres:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
# LOCAL_DATABASE_URL=

# ------------------------------------------------------------------------------
# Onboarding dev/testing flag
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GET_WORD_SIMULATE_FIRST_OPEN=true

# ------------------------------------------------------------------------------
# Admin stats exclusions
# ------------------------------------------------------------------------------
# Server-only filters for `/admin/stats`. Use these to keep personal/test
# accounts out of aggregate usage, activity, study, retention, subscription, and
# owned-list counts. Values can be comma-, semicolon-, or whitespace-separated.
# ADMIN_STATS_EXCLUDED_USER_EMAILS=you@example.com,test@example.com
# ADMIN_STATS_EXCLUDED_USER_IDS=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# PWA updates
# ------------------------------------------------------------------------------
# No configuration. A new service worker activates silently when all tabs close.
# For long-lived open sessions the update is applied silently the next time the
# app returns to the foreground, then the page reloads onto the new build.

# ------------------------------------------------------------------------------
# Google translation and text-to-speech
# ------------------------------------------------------------------------------
# Enables Google Translate-backed list translation.
GOOGLE_TRANSLATE_API_KEY=

# Enables Google Cloud Text-to-Speech audio generation.
GOOGLE_TTS_API_KEY=

# Optional quota/monitoring overrides. Defaults assume a 5% monthly share of one
# free-tier account per user.
# GOOGLE_TRANSLATE_FREE_MONTHLY_CHARS=500000
# GOOGLE_TTS_FREE_MONTHLY_CHARS=1000000
# GOOGLE_API_FREE_ACCOUNT_LIMIT_RATIO=0.05
# GOOGLE_TRANSLATE_ACCOUNT_MONTHLY_CHARS=25000
# GOOGLE_TTS_ACCOUNT_MONTHLY_CHARS=50000

# ------------------------------------------------------------------------------
# ArDrive Turbo / Arweave audio storage
# ------------------------------------------------------------------------------
# Enables uploading generated pronunciation audio to ArDrive Turbo.
# Provide either:
# - single-line Arweave JWK JSON
# - base64-encoded JWK JSON
ARDRIVE_TURBO_WALLET_JWK=

# Optional service overrides for self-hosted or custom Turbo endpoints.
# ARDRIVE_TURBO_UPLOAD_URL=https://upload.ardrive.io
# ARDRIVE_TURBO_PAYMENT_URL=https://payment.ardrive.io

# Optional playback gateway override. Comma-separated values are supported and
# will be tried before the built-in defaults:
# - https://turbo-gateway.com
# - https://arweave.net
# - https://ar-io.net
# ARWEAVE_GATEWAY_URL=https://turbo-gateway.com

# Optional client-visible override for playback URLs. Use this when you need the
# browser to prefer a specific gateway list distinct from the server setting.
# NEXT_PUBLIC_ARWEAVE_GATEWAY_URL=https://turbo-gateway.com,https://arweave.net


# ------------------------------------------------------------------------------
# Arweave Storage Fallback (Backblaze B2)
# ------------------------------------------------------------------------------
#
# Optional S3-compatible object store mirror for generated TTS audio (Backblaze B2).
# Keep the bucket private: audio bytes are proxied through /api/audio/[hash], not
# served from a public domain. If unset, generation still works through Arweave alone
# (the object store is a fallback mirror; Arweave stays the canonical source).
#
# All vars below must be set together — if any is missing the mirror is treated as
# unconfigured (writes are skipped, object_store rows return 503 in production).
#
# Active provider. Currently only "b2" is supported. Required in production (a missing
# value surfaces a misconfigured deploy); development/test default to b2.
# AUDIO_OBJECT_STORE_PROVIDER=b2
#
# S3 endpoint for your bucket, shown in the B2 bucket details as "Endpoint"
# (https://s3.<region>.backblazeb2.com). The <region> segment must match REGION below.
# AUDIO_OBJECT_STORE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
#
# Bucket region, e.g. eu-central-003 (EU/Amsterdam). Unlike Cloudflare R2 ("auto"), B2
# requires the real region — it is part of the SigV4 signature, so a mismatch fails auth.
# AUDIO_OBJECT_STORE_REGION=eu-central-003
#
# Application Key credentials (B2 console → Application Keys → "Add a New Application Key").
# Scope the key to this one bucket with Read and Write access. keyID → ACCESS_KEY_ID,
# applicationKey → SECRET_ACCESS_KEY (shown only once at creation).
# AUDIO_OBJECT_STORE_ACCESS_KEY_ID=
# AUDIO_OBJECT_STORE_SECRET_ACCESS_KEY=
#
# Bucket name (must be Private). Audio objects are stored under the key audio/<hash>.mp3.
# AUDIO_OBJECT_STORE_BUCKET=
#
# Optional per-object safety cap (bytes) for audio writes/reads — the max size of a single
# object, not a daily/total budget. Generated TTS files are normally tiny (~5 KB); default
# is 1 MB to catch accidental large uploads. Set provider-level daily caps in the B2
# console (Caps & Alerts) for runaway-cost protection.
# AUDIO_OBJECT_STORE_MAX_OBJECT_BYTES=1000000

# ------------------------------------------------------------------------------
# OpenRouter provider auth
# ------------------------------------------------------------------------------
# Server-funded OpenRouter API key used to generate the onboarding common word
# list (LLM call in features/learning/onboarding/server/autogenerate-common-list.ts).
# Without it, the "Continue" / autogenerate-common-list flow fails with
# "OpenRouter server key is not configured." Create a key at
# https://openrouter.ai/keys.
OPENROUTER_SERVER_API_KEY=

# Optional app identifier sent to OpenRouter during OAuth.
OPENROUTER_OAUTH_APP_ID=

# Optional bearer-auth compatibility for tenants that require auth on the key
# exchange endpoint. Either value is accepted by the app.
# OPENROUTER_OAUTH_BEARER_TOKEN=
# OPENROUTER_API_KEY=

# Optional endpoint overrides.
# OPENROUTER_AUTH_URL=https://openrouter.ai/auth
# OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_OAUTH_EXCHANGE_URL=https://openrouter.ai/api/v1/auth/keys

# Optional override for the Photo Lab vision model. Defaults to the advanced
# pro-tier model (see features/photo-lab/server/config.ts) for label quality;
# set a flash-tier model here to trade quality for speed/cost.
# OPENROUTER_PHOTO_LAB_MODEL=google/gemini-3.1-pro-preview

# ------------------------------------------------------------------------------
# School pilot
# ------------------------------------------------------------------------------
# Server-funded OpenRouter key for the "School AI" translation provider offered
# to members of a school pilot (features/schools/server/translation-requests.ts).
# One key covers all schools; per-school spend is attributed in the app's own
# `school_translation_requests` ledger, not at OpenRouter. Without this key the
# provider returns SCHOOL_AI_MODEL_UNAVAILABLE. Set a credit cap on the key in
# the OpenRouter console — per-user monthly limits bound each student, but
# nothing bounds the number of schools.
OPENROUTER_SCHOOL_API_KEY=

# Optional override for the school translation model. Defaults to
# anthropic/claude-sonnet-5 (see features/schools/server/config.ts). The model
# must support structured outputs — the request sends a strict json_schema with
# provider routing set to require_parameters.
# SCHOOL_OPENROUTER_TRANSLATION_MODEL=anthropic/claude-sonnet-5
#
# Access codes are stored as an unkeyed SHA-256 digest, so there is no school
# secret to configure and no secret whose rotation can invalidate links that
# teachers have already handed out. See features/schools/server/code.ts for why
# a key buys nothing against 100-bit random codes.

# ------------------------------------------------------------------------------
# Mobile / LAN development
# ------------------------------------------------------------------------------
# Comma-separated origins allowed to hit the Next.js dev server cross-origin
# (wired into next.config.js `allowedDevOrigins`). Set this to your machine's
# LAN IP so you can open the dev server from a phone on the same network and
# still sign in. Find your IP with `ipconfig getifaddr en0` (macOS Wi-Fi).
# NEXT_ALLOWED_DEV_ORIGINS=192.168.0.106
