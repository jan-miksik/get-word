# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Variables are grouped into REQUIRED and OPTIONAL:
# - REQUIRED: the app needs these to boot and let you sign in.
# - OPTIONAL: each one unlocks a feature that stays disabled until its vars are
#   present. The app boots fine without them.

# ##############################################################################
# REQUIRED
# ##############################################################################

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by Next.js routes and Drizzle.
#
# Local development / admin operations:
# - Prefer the Supabase "Direct connection" string.
# - Best for `pnpm run db:migrate`, `pg_dump`, `psql`, and restore scripts.
#
# Production / Vercel:
# - Prefer the Supabase "Connection Pooler" string.
#
# If your password contains special characters, use the URL-encoded form.
DATABASE_URL=

# ------------------------------------------------------------------------------
# App secrets
# ------------------------------------------------------------------------------
# Signs the app's `get_word_session` login cookie and OpenRouter OAuth state
# cookies. This session is the app's real source of truth (Supabase is only a
# one-shot identity verifier during login).
# Generate with:
#   openssl rand -base64 32
APP_SESSION_SECRET=

# Encrypts stored BYOK provider API keys at rest.
# Must be a stable 32-byte hex string.
# Generate with:
#   openssl rand -hex 32
APP_ENCRYPTION_SECRET=

# ------------------------------------------------------------------------------
# Supabase auth (primary login)
# ------------------------------------------------------------------------------
# Sign-in uses Supabase Auth: email one-time code and Google OAuth. Supabase is
# only a one-shot identity verifier — the `/api/auth/callback` route verifies the
# Supabase user, then the app mints its own long-lived `get_word_session` cookie
# (see APP_SESSION_SECRET), which is the trusted session afterwards.
# Find these in Supabase: Project Settings -> API keys.
#   - URL:              Project Settings -> API -> Project URL
#   - Publishable key:  the "Publishable key" (sb_publishable_…). Browser-safe.
# NEVER put the secret/service_role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# In the Supabase dashboard, also:
#   - Authentication -> Providers: enable Email and Google.
#   - Authentication -> URL Configuration -> Redirect URLs: add
#     http://localhost:3000/api/auth/callback (and your production equivalent).
#   - The email login is OTP-code based: turn "Confirm email" off and edit the
#     "Magic Link" email template to print {{ .Token }} instead of the default
#     link. See DEVELOPMENT.md ("Supabase Auth Setup") for the exact steps.

# ##############################################################################
# OPTIONAL
# ##############################################################################

# ------------------------------------------------------------------------------
# App base URL
# ------------------------------------------------------------------------------
# Public base URL used for absolute callback URLs (e.g. OAuth callbacks).
# Local dev can keep the default below. Set your real domain in production.
GET_WORD_APP_URL=http://localhost:3000

# Browser-visible version used when starting Supabase/Google OAuth.
# Set this to the same real production origin as GET_WORD_APP_URL.
NEXT_PUBLIC_GET_WORD_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Local source database override (dump/restore scripts)
# ------------------------------------------------------------------------------
# Defaults to Supabase CLI local Postgres:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
# LOCAL_DATABASE_URL=

# ------------------------------------------------------------------------------
# Onboarding dev/testing flag
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GET_WORD_SIMULATE_FIRST_OPEN=true

# ------------------------------------------------------------------------------
# Google translation and text-to-speech
# ------------------------------------------------------------------------------
# Enables Google Translate-backed list translation.
GOOGLE_TRANSLATE_API_KEY=

# Enables Google Cloud Text-to-Speech audio generation.
GOOGLE_TTS_API_KEY=

# Optional quota/monitoring overrides. Defaults assume a 5% monthly share of one
# free-tier account per user.
# GOOGLE_TRANSLATE_FREE_MONTHLY_CHARS=500000
# GOOGLE_TTS_FREE_MONTHLY_CHARS=1000000
# GOOGLE_API_FREE_ACCOUNT_LIMIT_RATIO=0.05
# GOOGLE_TRANSLATE_ACCOUNT_MONTHLY_CHARS=25000
# GOOGLE_TTS_ACCOUNT_MONTHLY_CHARS=50000

# ------------------------------------------------------------------------------
# ArDrive Turbo / Arweave audio storage
# ------------------------------------------------------------------------------
# Enables uploading generated pronunciation audio to ArDrive Turbo.
# Provide either:
# - single-line Arweave JWK JSON
# - base64-encoded JWK JSON
ARDRIVE_TURBO_WALLET_JWK=

# Optional service overrides for self-hosted or custom Turbo endpoints.
# ARDRIVE_TURBO_UPLOAD_URL=https://upload.ardrive.io
# ARDRIVE_TURBO_PAYMENT_URL=https://payment.ardrive.io

# Optional playback gateway override. Comma-separated values are supported and
# will be tried before the built-in defaults:
# - https://turbo-gateway.com
# - https://arweave.net
# - https://ar-io.net
# ARWEAVE_GATEWAY_URL=https://turbo-gateway.com

# Optional client-visible override for playback URLs. Use this when you need the
# browser to prefer a specific gateway list distinct from the server setting.
# NEXT_PUBLIC_ARWEAVE_GATEWAY_URL=https://turbo-gateway.com,https://arweave.net

# Optional. Required only when serving R2-backed audio through a proxy worker.
# MEDIA_PROXY_WORKER_URL=https://your-worker.example.workers.dev

# ------------------------------------------------------------------------------
# OpenRouter provider auth
# ------------------------------------------------------------------------------
# Optional app identifier sent to OpenRouter during OAuth.
OPENROUTER_OAUTH_APP_ID=

# Optional bearer-auth compatibility for tenants that require auth on the key
# exchange endpoint. Either value is accepted by the app.
# OPENROUTER_OAUTH_BEARER_TOKEN=
# OPENROUTER_API_KEY=

# Optional endpoint overrides.
# OPENROUTER_AUTH_URL=https://openrouter.ai/auth
# OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_OAUTH_EXCHANGE_URL=https://openrouter.ai/api/v1/auth/keys
