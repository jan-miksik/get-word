# Supabase Configuration
# Fill in your Supabase credentials from the Dashboard
# Direct PostgreSQL Connection String (for Drizzle ORM)
# Get this from Supabase Dashboard → Settings → Database → Connection String → Direct Connection
# Or use the Transaction Pooler connection string for better performance
DATABASE_URL=

# Secret used to sign login/session cookies and OAuth state cookies.
# Generate with: openssl rand -base64 32
APP_SESSION_SECRET=

# 32-byte secret used to encrypt stored BYOK provider API keys at rest.
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_SECRET=

WORDLINK_APP_URL=http://localhost:3000

NEXT_PUBLIC_REOWN_PROJECT_ID=

GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TTS_API_KEY=

# OpenRouter OAuth setup
# Optional app identifier sent to OpenRouter during OAuth.
OPENROUTER_OAUTH_APP_ID=
