# pnpm configuration
auto-install-peers=true

# WARNING: The following three settings fundamentally alter pnpm's dependency management model
# from strict isolation to npm-like hoisting, neutralizing pnpm's core value proposition.
#
# These were added as a workaround for Cloudflare deployment/build issues with @opennextjs/cloudflare
# (see commit d9bd1b2: "try to fix cloudflare deployment").
#
# TRADE-OFFS:
# - Increased risk of phantom dependencies (packages accessible without being declared)
# - Environment inconsistencies across different machines
# - Loss of pnpm's strict dependency isolation benefits
#
# RECOMMENDATIONS:
# - Consider investigating root cause: Are these settings truly necessary, or are there
#   alternative solutions (e.g., .pnpmfile.cjs, package version pinning, or upstream fixes)?
# - Monitor for phantom dependency issues in production
# - If possible, revert to strict isolation once the underlying build issue is resolved
#
# Related: open-next.config.ts has inline config "to avoid esbuild bundling issues with pnpm"

# Disables peer dependency version compatibility checks
# REQUIRED FOR: @opennextjs/cloudflare build compatibility (workaround)
strict-peer-dependencies=false

# Enables npm-like hoisting (all dependencies hoisted to node_modules root)
# REQUIRED FOR: @opennextjs/cloudflare module resolution during build (workaround)
shamefully-hoist=true

# Uses hoisted node linker instead of pnpm's default isolated structure
# REQUIRED FOR: @opennextjs/cloudflare build process (workaround)
node-linker=hoisted


