{
  "name": "get-word",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "dev:fast": "next dev --disable-source-maps",
    "build": "next build",
    "start": "next start",
    "mobile:dev": "corepack pnpm --dir mobile run dev",
    "mobile:build": "corepack pnpm --dir mobile run build",
    "mobile:sync:ios": "corepack pnpm --dir mobile run sync:ios",
    "mobile:open:ios": "corepack pnpm --dir mobile run open:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "check:dead-code": "knip",
    "check:boundaries": "node scripts/check-feature-boundaries.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run check:boundaries && pnpm test && pnpm run check:dead-code && pnpm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "npx tsx scripts/run-migrations.ts",
    "db:dev:backup": "bash scripts/backup-dev-db.sh",
    "db:prod": "bash scripts/production-db.sh",
    "db:prod:backup": "bash scripts/production-db.sh backup",
    "db:prod:migrate": "bash scripts/production-db.sh migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:dump-restore": "bash scripts/dump-and-restore.sh",
    "db:dump-restore-full": "bash scripts/dump-and-restore-full.sh",
    "db:backup": "bash scripts/backup-remote-db.sh",
    "ui:generate-locales": "tsx scripts/generate-ui-locales.ts",
    "demo:generate-words": "tsx scripts/generate-landing-demo-words.ts",
    "demo:generate-audio": "tsx scripts/generate-demo-audio.ts",
    "demo:generate-bundled-audio": "tsx scripts/generate-bundled-demo-audio.ts",
    "account:process-deletions": "tsx scripts/process-account-deletion-jobs.ts",
    "audio:check-object": "tsx scripts/check-object-storage.ts",
    "audio:backfill-object": "tsx scripts/backfill-object-audio.ts",
    "audio:prod:backfill-object": "bash scripts/production-db.sh backfill-object",
    "audio:prod:repair-object-to-arweave": "bash scripts/production-db.sh repair-object-to-arweave",
    "audio:repair-object-to-arweave": "tsx scripts/repair-object-to-arweave.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@ardrive/turbo-sdk": "^1.41.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome/capacitor-apple-sign-in": "^0.1.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-virtual": "^3.13.18",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "postgres": "^3.4.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "knip": "^6.27.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "7.3.5",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "axios": "1.16.1",
      "bn.js": "5.2.3",
      "defu": "6.1.7",
      "elliptic": "6.6.1",
      "esbuild": "0.25.0",
      "form-data@3": "3.0.5",
      "form-data@4": "4.0.6",
      "h3": "1.15.11",
      "hono": "4.12.25",
      "js-yaml@4": "4.2.0",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "postcss": "8.5.15",
      "qs": "6.15.2",
      "rollup": "4.60.4",
      "secp256k1": "5.0.1",
      "tmp": "0.2.7",
      "undici@5.29.0": "6.27.0",
      "undici@^7.0.0": "7.28.0",
      "uuid": "11.1.1",
      "vite": "7.3.5",
      "ws": "8.21.0"
    }
  }
}
