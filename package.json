{
  "name": "wordlink",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next .open-next && next build && opennextjs-cloudflare build --skipNextBuild",
    "preview": "pnpm build && opennextjs-cloudflare preview",
    "deploy": "pnpm build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "wrangler d1 migrations apply wordlink-db",
    "db:migrate:remote": "wrangler d1 migrations apply wordlink-db --remote"
  },
  "dependencies": {
    "@opennextjs/aws": "^3.9.7",
    "@opennextjs/cloudflare": "^1.14.7",
    "next": "^15.4.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.53.0"
  }
}

